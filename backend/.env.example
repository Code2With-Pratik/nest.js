NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace-with-a-locally-generated-password
POSTGRES_DB=taskflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://taskflow:replace-with-a-locally-generated-password@localhost:5432/taskflow?schema=public

JWT_ACCESS_SECRET=replace-with-a-locally-generated-secret
JWT_REFRESH_SECRET=replace-with-a-different-locally-generated-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Optional: set these if NestJS Observe is configured for this application.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
